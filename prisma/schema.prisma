// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
  binaryTargets = ["native", "linux-musl"]
}

// Canonical persistence authority: PostgreSQL via Prisma (STAB-BE-006).
// The libsql/SQLite adapter path has been retired; DATABASE_URL is the
// single production URL and prisma/migrations is the sole migration
// authority. Do not reintroduce a second ORM or dialect here.
datasource db {
  provider = "postgresql"
  // Prisma 7: connection URLs live in prisma.config.ts (datasource.url),
  // not in the schema. Keeping `url` here fails schema validation.
}

enum UserRole {
  contributor
  moderator
  admin
}

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Primary wallet address — canonical identifier for the user
  walletAddress String? @unique

  reputation Int @default(0)

  role UserRole @default(contributor)

  // Sybil Resistance
  worldcoinVerified   Boolean   @default(false)
  worldcoinVerifiedAt DateTime?

  wallets              Wallet[]
  sybilScores          SybilScore[]
  worldIdVerifications WorldIdVerification[]
  conversations        Conversation[]
}

model Wallet {
  id        String   @id @default(uuid())
  address   String
  chain     String
  linkedAt  DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([address, chain])
  // We will enforce "one address -> one user" logic in the service layer
  // to handle multi-chain address reguse scenarios properly.
}

model SybilScore {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Component scores (0-1 normalized)
  worldcoinScore Float @default(0.0) // Binary verification signal (0 or 1)
  walletAgeScore Float @default(0.0) // Based on wallet age
  stakingScore   Float @default(0.0) // Historical participation in staking
  accuracyScore  Float @default(0.0) // Claim accuracy from verification history

  // Final composite score (0-1)
  compositeScore Float @default(0.0) // Final Sybil resistance score

  // Metadata
  calculationDetails String? // JSON string for explainability

  explanation SybilExplanation?

  @@unique([userId, createdAt])
  @@index([userId])
  @@index([compositeScore])
}

model SybilExplanation {
  id           String   @id @default(uuid())
  sybilScoreId String   @unique
  explanation  String
  createdAt    DateTime @default(now())

  sybilScore SybilScore @relation(fields: [sybilScoreId], references: [id], onDelete: Cascade)
}

model WorldIdVerification {
  id          String   @id @default(uuid())
  verifiedAt  DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  nullifierHash     String  @unique
  verificationLevel String
  worldcoinAppId    String
  worldcoinAction   String
  merkleRoot        String?
  proof             Json?

  @@index([userId])
  @@index([nullifierHash])

  @@map("world_id_verifications")
}

model Conversation {
  id        String   @id @default(uuid())
  title     String?
  createdAt  DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  role           String       // "user", "assistant", "system"
  content        String
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())

  @@index([conversationId])
}

model ContextDocument {
  id        String   @id @default(uuid())
  title     String
  category  String
  content   String
  tags      String   // Stored as JSON string
  sourceUrl String?
  isActive  Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isActive])
}

model AiUsageMetric {
  id              String   @id @default(uuid())
  userId          String?
  provider        String   // e.g., "openai", "anthropic"
  model           String
  promptTokens    Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens     Int      @default(0)
  latencyMs       Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([provider])
}

// Protocol Analytics & Reporting API models

model AnalyticsEvent {
  id        String   @id @default(uuid())
  eventType String // e.g., "claim_submitted", "verification_completed", "reward_distributed"
  entityType String? // e.g., "claim", "proposal", "user"
  entityId   String?
  userId    String?
  data        Json?
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([eventType, occurredAt])
  @@index([entityType, entityId])
  @@index([userId])
}

model MetricAggregate {
  id         String   @id @default(uuid())
  metricKey  String // e.g., "total_claims", "active_verifiers"
  period     String // e.g., "hourly", "daily", "weekly", "monthly", "yearly", "all"
  bucketStart DateTime
  filters    String @default("{}") // Canonical JSON string representing dimensions e.g. chain, role
  value       Float @default(0)
  updatedAt  DateTime @updatedAt

  @@index([metricKey, period, bucketStart])
  @@unique([metricKey, period, bucketStart, filters])
}

model ReportJob {
  id            String   @id @default(uuid())
  name          String?
  reportType    String // "protocol_summary", "user_analytics", "verification_analytics", "governance_analytics", "financial_analytics", "custom"
  filters      Json?
  format       String @default("json") // "json", "csv", "pdf"
  status       String @default("pending") // "pending", "running", "completed", "failed"
  progress      Float @default(0)
  fileUrl       String?
  error         String?
  createdAt     DateTime @default(now())
  startedAt     DateTime?
  completedAt    DateTime?
  scheduledFor   DateTime?
  createdByUserId String?

  @@index([status])
  @@index([createdAt])
  @@index([scheduledFor])
}

model MonitoringMetric {
  id         String   @id @default(uuid())
  name        String // e.g., "report_generation_time", "query_latency", "cache_hit_ratio"
  value       Float
  labels       Json?
  recordedAt   DateTime @default(now())

  @@index([name, recordedAt])
}

// ---------------------------------------------------------------------------
// Transactional Outbox (V2-BE-048)
// ---------------------------------------------------------------------------
// OutboxEvent rows are written inside the same DB transaction as any
// projection change. A background poller claims PENDING rows and relays
// them to BullMQ, then marks them DISPATCHED.  The processor enforces
// idempotency via a Redis SETNX guard keyed on idempotencyKey.
//
// Security: payload stores only non-sensitive routing metadata (aggregateId,
// eventType, recipientIds). No private claim text, user PII, or settlement
// data is persisted here.
// ---------------------------------------------------------------------------
model OutboxEvent {
  id             String   @id @default(uuid())
  // Domain event type, e.g. "notification.send", "webhook.deliver"
  eventType      String
  // Aggregate identifier for the triggering entity (e.g. notificationId)
  aggregateId    String
  // Routing metadata only — no private claim or settlement data
  payload        String   // JSON-encoded OutboxEventPayload
  // Stable key used by the processor for exactly-once delivery
  idempotencyKey String   @unique
  status         String   @default("PENDING") // PENDING | DISAPTCHED | DEAD_LETTER
  // BullMQ job id once dispatched (for observability)
  jobId          String?
  retryCount     Int      @default(0)
  maxRetries     Int      @default(5)
  lastError      String?
  scheduledAt    DateTime @default(now())
  processedAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, scheduledAt])
  @@index([aggregateId])
  @@index([idempotencyKey])
  @@index([eventType, status])
}

// ---------------------------------------------------------------------------
// V2 indexer: block cursor + reorg ancestry
// Supports src/v2/block-cursor (reorg detection y walking parentHash back to
// a common ancestor). Heights are BigInt because some EVM chains exceed
// Number.MAX_SAFE_INTEGER.
// ---------------------------------------------------------------------------

model BlockCursor {
  id     String @id @default(uuid())
  chainId Int
  // Logical indexer stream, e.g. "canonical-events"
  source String

  processedHeight BigInt @default(0)
  processedHash   String @default("")
  safeHeight      BigInt @default(0)
  safeHash        String @default("")
  finalizedHeight  BigInt @default(0)
  finalizedHash    String @default("")

  // Monotonic CAS guard (PREWAVE-BE-038): the release/projection this cursor
  // belongs to, plus the deployment floor and checkpoint provenance. A writer
  // may only advance the cursor when its (releaseId, projection) matches and
  // its height is strictly greater than processedHeight.
  releaseId       String @default("")
  projection      String @default("")
  deploymentBlock BigInt @default(0)
  artifactChecksum String @default("")
  checkpointSource String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ancestors BlockCursorAncestor[]

  @@unique([chainId, source, releaseId, projection])
  @@index([chainId])
  @@index([chainId, releaseId, projection])
}

model BlockCursorAncestor {
  id       String @id @default(uuid())
  cursorId String
  cursor   BlockCursor @relation(fields: [cursorId], references: [id], onDelete: Cascade)

  height BigInt
  hash   String
  parentHash String
  // observed | safe | finalized (matches ConfirmationLevel in block-cursor.types.ts)
  confirmation String    @default("observed")
  // False once this height is known to belong to an orphaned branch
  isCanonical Boolean   @default(true)
  // Provenance of the checkpoint that produced this ancestor row.
  releaseId       String @default("")
  artifactChecksum String @default("")

  createdAt DateTime @default(now())

  @@unique([cursorId, height, hash])
  @@index([cursorId, isCanonical])
  @@index([cursorId, releaseId])
}

// ---------------------------------------------------------------------------
// V2 indexer: canonical-identity dedup for raw EVM logs.
// A replay of the same (chainId, blockHash, txHash, logIndex) is rejected;
// the same log position under a different block hash is retained so reorgs
// stay diagnosable.
// ---------------------------------------------------------------------------

model ChainEvent {
  id              String   @id @default(uuid())
  chainId         Int
  contractAddress String
  eventName       String
  // Decimal string, never a JS number/float.
  blockNumber     String
  blockHash       String
  txHash          String
  logIndex        Int
  blockTimestamp  DateTime?
  // JSON-encoded RawChainLog.payload
  payload         String
  // JSON-encoded RawChainLog.rawArgs
  rawArgs         String

  // Decoder version that produced this row — traceable provenance for
  // canonical identity and replay/rollback decisions.
  decoderVersion  String   @default("v1")
  // Release/artifact provenance binding (fail closed on mismatch).
  releaseId       String?
  // Canonical identity key: chain/release/blockHash/tyHash/logIndex/decoderVersion.
  // Enforced unique so reprocessing cannot duplicate effects.
  canonicalKey    String   @unique
  // Removed-log handling: when a reorg orphans this log, mark removed and
  // route through rollback flow instead of deleting.
  removed         Boolean  @default(false)
  removedAt       DateTime?
  ingestedAt DateTime @default(now())

  @@unique([chainId, blockHash, txHash, logIndex])
  @@index([chainId, txHash, logIndex])
  @@index([eventName, blockNumber])
  @@index([chainId, removed])
  @@index([canonicalKey])
  @@index([decoderVersion])
}

// ---------------------------------------------------------------------------
// PREWAVE-BE-008: Resumable WebSocket streams with backfill tokens.
//
// A StreamSession is opened by a client subscribing to a projection stream.
// Each delivered envelope is persisted as a StreamEvent so that a reconnect
// can be resumed from an opaque resume token. Resume tokens are stored
// hashed (never the raw token) and are bound to chain/release/block/
// projection version so that a wrong-release or wrong-chain resume fails
// closed. Backfill is served from StreamEvent rows within a bounded window.
//
// Security: envelopes carry only routing metadata and a projection payload
// reference — no secrets, authorization material, or protected rationale.
// ---------------------------------------------------------------------------

model StreamSession {
  id String @id @default(uuid())

  // Chain-derived binding — every session is pinned to a single chain,
  // release, deployment block, and artifact checksum.
  chainId          Int
  releaseId        String
  deploymentBlock  BigInt
  artifactChecksum String

  // Logical projection stream, e.g. "claims", "rewards"
  projection       String
  projectionVersion Int

  // Opaque resume token, stored hashed. Raw token is only returned to client.
  resumeTokenHash String @unique
  // When the current resume token expires; expired tokens force bounded resync.
  resumeTokenExpiresAt DateTime

  // Last event successfully acknowledged by the client (cursor).
  lastAckedEventId String?
  lastAckedCursor  BigInt @default(0)

  // Lifecycle: ACTIVE | CLOSED | EXPIRED | RESYNC_REQUIRED
  status String @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events StreamEvent[]

  @@index([chainId, releaseId, projection])
  @@index([status, resumeTokenExpiresAt])
  @@index([resumeTokenHash])
}

model StreamEvent {
  id String @id @default(uuid())

  sessionId String
  session   StreamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Monotonic per-session cursor used for gap/duplicate detection.
  cursor BigInt

  // Versioned envelope fields (see stream-envelope.types.ts).
  envelopeVersion   Int
  eventId           String
  chainId           Int
  releaseId         String
  blockNumber       BigInt
  blockHash         String
  freshness         String // "observed" | "safe" | "finalized"
  projectionVersion Int

  // Reference to the canonical read-model row this envelope projects.
  // The actual payload is resolved from the canonical read model on
  // delivery — never stored inline here.
  projectionRef String

  // JSON-encoded routing metadata only (no protected payload).
  metadata String @default("{}")

  // Delivery state for backfill and idempotency.
  deliveredAt DateTime?
  createdAt   DateTime @default(now())

  @@unique([sessionId, cursor])
  @@unique([sessionId, eventId])
  @@index([sessionId, cursor])
  @@index([chainId, releaseId, blockNumber])
}

model StreamBackfillRequest {
  id String @id @default(uuid())

  sessionId String

  // Bounded backfill window requested by the client.
  fromCursor BigInt
  toCursor   BigInt

  // Outcome: PENDING | SERVED | REJECTED_GAP | REJECTED_EXPIRED | REJECTED_RELEASE
  status String @default("PENDING")
  reason String?

  requestedAt DateTime @default(now())
  servedAt    DateTime?

  @@index([sessionId, requestedAt])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Feature flags & configuration rollback (PREWAVE-BE-034)
// ---------------------------------------------------------------------------
// Feature flags are versioned, compare-and-swap guarded records. Every write
// must supply the expected version; a mismatch fails closed. Rollback targets
// are validated against release/schema boundaries before being applied, and
// every state transition is recorded as an immutable audit event.
//
// Security: flags are advisory only. They MUST NOT grant protocol authority
// (e.g. bypassing canonical contract/finalized event checks). Chain-derived
// data is bound to chainId + releaseId + deploymentBlock + artifactChecksum.
// ---------------------------------------------------------------------------

model FeatureFlag {
  id        String   @id @default(uuid())
  // Stable, unique flag key (e.g. "v2.indexer.enabled")
  key       String   @unique
  description String?

  // Current value as canonical JSON string (never a JS object literal)
  value     String   @default("false")
  // Monotonic version used for optimistic concurrency (compare-and-swap)
  version   Int      @default(1)

  // Release/schema boundary this flag is valid within
  releaseId        String?
  schemaVersion    String?
  chainId          Int?
  deploymentBlock  BigInt?
  artifactChecksum String?

  // Lifecycle: active | rolled_back | disabled
  status    String   @default("active")

  // Actor who last mutated the flag (wallet address or service identity)
  updatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rollbackTargets FeatureFlagRollbackTarget[]
  auditEvents     FeatureFlagAuditEvent[]

  @@index([status])
  @@index([releaseId])
  @@index([chainId])
  @@index([releaseId, schemaVersion])
  @@index([key, version])
}

// A validated, immutable snapshot a flag may be rolled back to. Targets are
// only created after passing release/schema compatibility checks, so a
// rollback can never cross an incompatible boundary.
model FeatureFlagRollbackTarget {
  id        String   @id @default(uuid())

  flagId String
  flag   FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)

  // Snapshot of the flag state at the target version
  targetVersion Int
  targetValue   String

  // Boundary binding — must match the flag's release/schema at apply time
  releaseId        String?
  schemaVersion    String?
  chainId          Int?
  deploymentBlock  BigInt?
  artifactChecksum String?

  // Validation outcome: valid | invalid | revoked
  validationStatus String @default("valid")
  validatedAt      DateTime?
  validatedBy      String?
  validationReason String?

  createdAt DateTime @default(now())

  @@unique([flagId, targetVersion])
  @@index([flagId, validationStatus])
  @@index([releaseId])
  @@index([flagId, releaseId, schemaVersion])
}

// Append-only audit trail for every flag mutation and rollback attempt.
// Records both successful and rejected transitions so stale/unauthorized
// attempts remain auditable.
model FeatureFlagAuditEvent {
  id        String   @id @default(uuid())

  flagId String
  flag   FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)

  // e.g. "update", "rollback", "rollback_rejected", "target_validated"
  action String

  // Version before/after the transition (null when not applicable)
  fromVersion Int?
  toVersion   Int?

  // Actor identity (wallet address or service identity); null if anonymous
  actorId String?
  // Whether the actor was authorized for this action
  actorAuthorized Boolean @default(false)

  // Outcome: applied | rejected | noop
  outcome String
  // Machine-readable reason for rejection (e.g. "stale_version")
  reason  String?

  // Boundary context captured at event time
  releaseId        String?
  schemaVersion    String?
  chainId          Int?
  deploymentBlock  BigInt?
  artifactChecksum String?

  // Non-sensitive metadata only (no PII / private payloads)
  metadata String?

  createdAt DateTime @default(now())

  @@index([flagId, createdAt])
  @@index([action, outcome])
  @@index([actorId])
  @@index([flagId, fromVersion, toVersion])
}

// ----------------------------------------------------------------------------
// PREWAVE-BE-079: Secret detection & quarantine for support submissions.
// Support text/attachments are scanned for seed phrases, private keys,
// tokens, auth headers, credentials, and protected evidence before
// persistence or forwarding. High-confidence detections are quarantined
// here instead of being stored inline, and access is restricted/audited.
// Detected secret material is never echoed into logs/notifications.
// ---------------------------------------------------------------------------

model SupportSubmission {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Opaque reference to the submitting user; no PII stored inline.
  userId String?

  // Sanitized/redacted text safe for persistence and forwarding.
  sanitizedText String @default("")
}

// ---------------------------------------------------------------------------
// PREWAVE-BE-049: Dead-letter replay authorization + idempotency.
// Replay is denied by default. Each authorized replay is bound to the
// original dead-letter record via an immutable reference, requires a
// protected capability, reason, bounds, dry-run flag, original payload
// hash, and an audit record. Replays are rejected across release/schema
// incompatibility and duplicate replays of the same original are blocked.
// ---------------------------------------------------------------------------

model DeadLetterReplay {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Immutable reference to the original dead-letter record.
  originalDeadLetterId String
  // SHA-256 of the original payload; replay must match this exactly.
  originalPayloadHash  String
  // Chain/release binding — replay is rejected if any of these drift.
  chainId              Int
  releaseId            String
  deploymentBlock      BigInt
  artifactChecksum     String

  // Operator-supplied authorization context.
  capability           String
  reason               String
  requestedBy          String
  dryRun               Boolean  @default(true)

  // Bounded batch execution.
  batchId              String?
  batchSize            Int      @default(1)
  batchOffset          Int      @default(0)

  // Lifecycle: PENDING | AUTHORIZED | RUNNING | PAUSED | COMPLETED | FAILED | REJECTED
  status               String   @default("PENDING")
  // Idempotency key derived from (originalDeadLetterId, originalPayloadHash).
  idempotencyKey       String   @unique
  // Set once a replay has produced effects; prevents duplicate effects.
  effectAppliedAt      DateTime?
  lastError            String?

  auditRecords DeadLetterReplayAudit[]

  @@unique([originalDeadLetterId, originalPayloadHash])
  @@index([status, createdAt])
  @@index([batchId])
  @@index([chainId, releaseId])
}

model DeadLetterReplayAudit {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  replayId String
  replay   DeadLetterReplay @relation(fields: [replayId], references: [id], onDelete: Cascade)

  // Actor + action for immutable audit trail.
  actor     String
  action    String
  // JSON-encoded structured detail; never contains private payload data.
  detail    String   @default("{}")

  @@index([replayId, createdAt])
  @@index([actor])
}

// ----------------------------------------------------------------------------
// PREWAVE-BE-058: Inbound webhook signature verification & replay protection.
// Raw signed bytes are preserved so provider-specific HMAC/canonicalization
// can be recomputed exactly. Delivery-ID uniqueness is enforced at the DB
// level so replays are rejected transactionally. Secrets are never stored
// here — only opaque key identifiers for rotation bookkeeping.
// ----------------------------------------------------------------------------

model WebhookProviderConfig {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Provider identifier, e.g. "github", "stripe", "stellar". Unknown
  // providers must fail closed at the service layer.
  provider String @unique

  // Timestamp tolerance in seconds for replay-window enforcement.
  timestampToleranceSeconds Int @default(300)

  // Maximum accepted raw body size in bytes; oversized bodies are rejected
  // before signature verification.
  maxBodyBytes Int @default(1048576)

  // Whether this provider is currently active. Inactive providers fail closed.
  isActive Boolean @default(true)

  // Opaque reference to the current signing secret in the secret store.
  // Never the secret material itself.
  activeSecretRef String?

  // JSON array of opaque secret refs retained for rotation grace windows.
  rotatedSecretRefs String @default("[]")

  // Deliveries are intentionally not a Prisma relation: WebhookDelivery.provider
  // is a denormalized audit key (see that model), and runtime persistence goes
  // through TypeORM. A one-sided relation here fails prisma generate (P1012).

  @@index([isActive])
}

model WebhookDelivery {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // Provider identifier (denormalized for fast lookup / audit).
  provider String

  // Provider-supplied delivery identifier; uniqueness per provider enforces
  // transactional replay rejection.
  deliveryId String

  // Opaque secret ref used to verify this delivery (supports rotation audit).
  secretRef String?

  // Provider-supplied timestamp (epoch seconds or ISO, provider-specific).
  // Stored as DateTime for tolerance checks; raw value preserved in headers.
  eventTimestamp DateTime?

  // SHA-256 of the raw signed body, for integrity and dedup diagnostics.
  bodySha256 String

  // Size of the raw body in bytes.
  bodyBytes Int

  // Verification outcome: "accepted" | "rejected". Rejected rows are kept
  // for audit; accepted rows are the transactional replay guard.
  status String @default("accepted")

  // Non-sensitive rejection reason (e.g. "bad_signature", "stale_timestamp",
  // "oversized_body", "unknown_provider"). Never contains secret material.
  rejectionReason String?

  // Server receipt time used for replay-window and tolerance auditing.
  receivedAt DateTime @default(now())

  @@unique([provider, deliveryId])
  @@index([provider, createdAt])
  @@index([status, createdAt])
  @@index([provider, receivedAt])
}