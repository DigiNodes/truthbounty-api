// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
  binaryTargets = ["native", "linux-musl"]
}

// Actual runtime datasource is SQLite via the libsql driver adapter
// (see src/prisma/prisma.service.ts, DATABASE_URL=file:./dev.db) this 
// matches prisma/migrations/migration_lock.toml, which already records
// "sqlite" as the migration dialect. Declaring "postgresql" here caused
 // PrismaClientInitializationError at runtime ("Driver Adapter
// @prisma/adapter-libsql, based on sqlite, is not compatible with the
// provider postgress") once the client was regenerated against the
// package-lock-pinned prisma@7.4.1, which validates this consistency.
datasource db {
  provider = "sqlite"
}

enum UserRole {
  contributor
  moderator
  admin
}

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updated

  // Primary wallet address — canonical identifier for the user
  walletAddress String @unique

  reputation Int @default(0)

  role UserRole @default(contributor)

  // Sybil Resistance
  worldcoinVerified   Boolean   @default(false)
  worldcoinVerifiedAt DateTime?

  wallets              Wallet[]
  sybilScores          SybilScore[]
  worldIdVerifications WorldIdVerification[]
  conversations        Conversation[]
}

model Wallet {
  id        String   @id @default(uuid())
  address   String
  chain     String
  linkedAt  DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([address, chain])
  // We will enforce "one address -> one user" logic in the service layer
  // to handle multi-chain address reguse scenarios properly.
}

model SybilScore {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updated

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Component scores (0-1 normalized)
  worldcoinScore Float @default(0.0) // Binary verification signal (0 or 1)
  walletAgeScore Float @default(0.0) // Based on wallet age
  stakingScore   Float @default(0.0) // Historical participation in staking
  accuracyScore  Float @default(0.0) // Claim accuracy from verification history

  // Final composite score (0-1)
  compositeScore Float @default(0.0) // Final Sybil resistance score

  // Metadata
  calculationDetails String? // JSON string for explainability

  explanation SybilExplanation?

  @@unique([userId, createdAt])
  @@index([userId])
  @@index([compositeScore])
}

model SybilExplanation {
  id           String   @id @default(uuid())
  sybilScoreId String   @unique
  explanation  String
  createdAt    DateTime @default(now())

  sybilScore SybilScore @relation(fields: [sybilScoreId], references: [id], onDelete: Cascade)
}

model WorldIdVerification {
  id          String   @id @default(uuid())
  verifiedAt  DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  nullifierHash     String  @unique
  verificationLevel String
  worldcoinAppId    String
  worldcoinAction   String
  merkleRoot        String?
  proof             Json?

  @@index([userId])
  @@index([nullifierHash])

  @@map("world_id_verifications")
}

model Conversation {
  id        String   @id @default(uuid())
  title     String?
  createdAt  DateTime @default(now())
  updatedAt DateTime @updated
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  role           String       // "user", "assistant", "system"
  content        String
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())

  @@index([conversationId])
}

model AiUsageMetric {
  id              String   @id @default(uuid())
  userId          String?
  provider        String   // e.g., "openai", "anthropic"
  model           String
  promptTokens    Int      @default(0)
  completionTokens Int     @default(0)
  totalTokens     Int      @default(0)
  latencyMs       Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([provider])
}

// Protocol Analytics & Reporting API models

model AnalyticsEvent {
  id        String   @id @default(uuid())
  eventType String // e.g., "claim_submitted", "verification_completed", "reward_distributed"
  entityType String? // e.g., "claim", "proposal", "user"
  entityId   String?
  userId    String?
  data        Json?
  occurredAt  DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([eventType, occurredAt])
  @@index([entityType, entityId])
  @@index([userId])
}

model MetricAggregate {
  id         String   @id @default(uuid())
  metricKey  String // e.g., "total_claims", "active_verifiers"
  period     String // e.g., "hourly", "daily", "weekly", "monthly", "yearly", "all"
  bucketStart DateTime
  filters    String @default("{}") // Canonical JSON string representing dimensions e.g. chain, role
  value       Float @default(0)
  updatedAt  DateTime @updated

  @@index([metricKey, period, bucketStart])
  @@unique([metricKey, period, bucketStart, filters])
}

model ReportJob {
  id            String   @id @default(uuid())
  name          String?
  reportType    String // "protocol_summary", "user_analytics", "verification_analytics", "governance_analytics", "financial_analytics", "custom"
  filters      Json?
  format       String @default("json") // "json", "csv", "pdf"
  status       String @default("pending") // "pending", "running", "completed", "failed"
  progress      Float @default(0)
  fileUrl       String?
  error         String?
  createdAt     DateTime @default(now())
  startedAt     DateTime?
  completedAt    DateTime?
  scheduledFor   DateTime?
  createdByUserId String?

  @@index([status])
  @@index([createdAt])
  @@index([scheduledFor])
}

model MonitoringMetric {
  id         String   @id @default(uuid())
  name        String // e.g., "report_generation_time", "query_latency", "cache_hit_ratio"
  value       Float
  labels       Json?
  recordedAt   DateTime @default(now())

  @@index([name, recordedAt])
}
