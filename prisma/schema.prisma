// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
  binaryTargets = ["native", "linux-musl"]
}

// Actual runtime datasource is SQLite via the libsql driver adapter
// (see src/prisma/prisma.service.ts, DATABASE_URL="file:./dev.db") this 
// matches prisma/migrations/migration_lock.toml, which already records
// "sqlite" as the migration dialect. Declaring "postgresql" here caused
 // PrismaClientInitializationError at runtime ("Driver Adapter
// @prisma/adapter-libsql, based on sqlite, is not compatible with the
// provider postgress") once the client was regenerated against the
// package-lock-pinned prisma@7.4.1, which validates this consistency.
datasource db {
  provider = "sqlite"
}

enum UserRole {
  contributor
  moderator
  admin
}

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Primary wallet address — canonical identifier for the user
  walletAddress String? @unique

  reputation Int @default(0)

  role UserRole @default(contributor)

  // Sybil Resistance
  worldcoinVerified   Boolean   @default(false)
  worldcoinVerifiedAt DateTime?

  wallets              Wallet[]
  sybilScores          SybilScore[]
  worldIdVerifications WorldIdVerification[]
  conversations        Conversation[]
}

model Wallet {
  id        String   @id @default(uuid())
  address   String
  chain     String
  linkedAt  DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([address, chain])
  // We will enforce "one address -> one user" logic in the service layer
  // to handle multi-chain address reguse scenarios properly.
}

model SybilScore {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Component scores (0-1 normalized)
  worldcoinScore Float @default(0.0) // Binary verification signal (0 or 1)
  walletAgeScore Float @default(0.0) // Based on wallet age
  stakingScore   Float @default(0.0) // Historical participation in staking
  accuracyScore  Float @default(0.0) // Claim accuracy from verification history

  // Final composite score (0-1)
  compositeScore Float @default(0.0) // Final Sybil resistance score

  // Metadata
  calculationDetails String? // JSON string for explainability

  explanation SybilExplanation?

  @@unique([userId, createdAt])
  @@index([userId])
  @@index([compositeScore])
}

model SybilExplanation {
  id           String   @id @default(uuid())
  sybilScoreId String   @unique
  explanation  String
  createdAt    DateTime @default(now())

  sybilScore SybilScore @relation(fields: [sybilScoreId], references: [id], onDelete: Cascade)
}

model WorldIdVerification {
  id          String   @id @default(uuid())
  verifiedAt  DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  nullifierHash     String  @unique
  verificationLevel String
  worldcoinAppId    String
  worldcoinAction   String
  merkleRoot        String?
  proof             Json?

  @@index([userId])
  @@index([nullifierHash])

  @@map("world_id_verifications")
}

model Conversation {
  id        String   @id @default(uuid())
  title     String?
  createdAt  DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  role           String       // "user", "assistant", "system"
  content        String
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())

  @@index([conversationId])
}

model ContextDocument {
  id        String   @id @default(uuid())
  title     String
  category  String
  content   String
  tags      String   // Stored as JSON string
  sourceUrl String?
  isActive  Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isActive])
}

model AiUsageMetric {
  id              String   @id @default(uuid())
  userId          String?
  provider        String   // e.g., "openai", "anthropic"
  model           String
  promptTokens    Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens     Int      @default(0)
  latencyMs       Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([provider])
}

// Protocol Analytics & Reporting API models

model AnalyticsEvent {
  id        String   @id @default(uuid())
  eventType String // e.g., "claim_submitted", "verification_completed", "reward_distributed"
  entityType String? // e.g., "claim", "proposal", "user"
  entityId   String?
  userId    String?
  data        Json?
  occurredAt  DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([eventType, occurredAt])
  @@index([entityType, entityId])
  @@index([userId])
}

model MetricAggregate {
  id         String   @id @default(uuid())
  metricKey  String // e.g., "total_claims", "active_verifiers"
  period     String // e.g., "hourly", "daily", "weekly", "monthly", "yearly", "all"
  bucketStart DateTime
  filters    String @default("{}") // Canonical JSON string representing dimensions e.g. chain, role
  value       Float @default(0)
  updatedAt  DateTime @updatedAt

  @@index([metricKey, period, bucketStart])
  @@unique([metricKey, period, bucketStart, filters])
}

model ReportJob {
  id            String   @id @default(uuid())
  name          String?
  reportType    String // "protocol_summary", "user_analytics", "verification_analytics", "governance_analytics", "financial_analytics", "custom"
  filters      Json?
  format       String @default("json") // "json", "csv", "pdf"
  status       String @default("pending") // "pending", "running", "completed", "failed"
  progress      Float @default(0)
  fileUrl       String?
  error         String?
  createdAt     DateTime @default(now())
  startedAt     DateTime?
  completedAt    DateTime?
  scheduledFor   DateTime?
  createdByUserId String?

  @@index([status])
  @@index([createdAt])
  @@index([scheduledFor])
}

model MonitoringMetric {
  id         String   @id @default(uuid())
  name        String // e.g., "report_generation_time", "query_latency", "cache_hit_ratio"
  value       Float
  labels       Json?
  recordedAt   DateTime @default(now())

  @@index([name, recordedAt])
}

// ----------------------------------------------------------------------------
// Transactional Outbox (V2-BE-048)
// ----------------------------------------------------------------------------
// OutboxEvent rows are written inside the same DB transaction as any
// projection change. A background poller claims PENDING rows and relays
// them to BullMQ, then marks them DISPATCHED.  The processor enforces
// idempotency via a Redis SETNX guard keyed on idempotencyKey.
//
// Security: payload stores only non-sensitive routing metadata (aggregateId,
// eventType, recipientIds). No private claim text, user PII, or settlement
// data is persisted here.
// ----------------------------------------------------------------------------
model OutboxEvent {
  id             String   @id @default(uuid())
  // Domain event type, e.g. "notification.send", "webhook.deliver"
  eventType      String
  // Aggregate identifier for the triggering entity (e.g. notificationId)
  aggregateId    String
  // Routing metadata only — no private claim or settlement data
  payload        String   // JSON-encoded OutboxEventPayload
  // Stable key used by the processor for exactly-once delivery
  idempotencyKey String   @unique
  status         String   @default("PENDING") // PENDING | DISPATCHED | DEAD_LETTER
  // BullMQ job id once dispatched (for observability)
  jobId          String?
  retryCount     Int      @default(0)
  maxRetries     Int      @default(5)
  lastError      String?
  scheduledAt    DateTime @default(now())
  processedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, scheduledAt])
  @@index([aggregateId])
  @@index([idempotencyKey])
  @@index([eventType, status])
}

// ----------------------------------------------------------------------------
// V2 indexer: block cursor + reorg ancestry
// Supports src/v2/block-cursor (reorg detection y walking parentHash back to
// a common ancestor). Heights are BigInt because some EVM chains exceed
// Number.MAX_SAFE_INTEGER.
// ----------------------------------------------------------------------------

model BlockCursor {
  id     String @id @default(uuid())
  chainId Int
  // Logical indexer stream, e.g. "canonical-events"
  source String

  processedHeight BigInt @default(0)
  processedHash   String @default("")
  safeHeight      BigInt @default(0)
  safeHash        String @default("")
  finalizedHeight BigInt @default(0)
  finalizedHash   String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ancestors BlockCursorAncestor[]

  @@unique([chainId, source])
  @@index([chainId])
}

model BlockCursorAncestor {
  id       String @id @default(uuid())
  cursorId String
  cursor   BlockCursor @relation(fields: [cursorId], references: [id], onDelete: Cascade)

  height BigInt
  hash   String
  parentHash String
  // observed | safe | finalized (matches ConfirmationLevel in block-cursor.types.ts)
  confirmation String    @default("observed")
  // False once this height is known to belong to an orphaned branch
  isCanonical Boolean   @default(true)

  createdAt DateTime @default(now())

  @@unique([cursorId, height, hash])
  @@index([cursorId, isCanonical])
}

// ----------------------------------------------------------------------------
// V2 indexer: canonical-identity dedup for raw EVM logs.
// A replay of the same (chainId, blockHash, txHash, logIndex) is rejected;
// the same log position under a different block hash is retained so reorgs
// stay diagnosable.
// ----------------------------------------------------------------------------

model ChainEvent {
  id              String   @id @default(uuid())
  chainId         Int
  contractAddress String
  eventName       String
  // Decimal string, never a JS number/float.
  blockNumber     String
  blockHash       String
  txHash          String
  logIndex        Int
  blockTimestamp  DateTime?
  // JSON-encoded RawChainLog.payload
  payload         String
  // JSON-encoded RawChainLog.rawArgs
  rawArgs         String

  ingestedAt DateTime @default(now())

  @@unique([chainId, blockHash, txHash, logIndex])
  @@index([chainId, txHash, logIndex])
  @@index([eventName, blockNumber])
}

// ----------------------------------------------------------------------------
// PREWAVE-BE-079: Secret detection & quarantine for support submissions.
// Support text/attachments are scanned for seed phrases, private keys,
// tokens, auth headers, credentials, and protected evidence before
// persistence or forwarding. High-confidence detections are quarantined
// here instead of being stored inline, and access is restricted/audited.
// Detected secret material is never echoed into logs/notifications.
// ----------------------------------------------------------------------------

model SupportSubmission {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Opaque reference to the submitting user; no PII stored inline.
  userId String?

  // Sanitized/redacted text safe for persistence and forwarding.
  sanitizedText String @default("")

  // Quarantine status for this submission.
  // clean | quarantined | released
  status String @default("clean")

  // High-confidence detection count (secret material redacted before storage).
  detectionCount Int @default(0)

  // Detection categories found (JSON array of classifier labels, no secret values).
  detectionTypes String @default("[]")

  // Opaque reference to quarantined attachment blob, if any.
  quarantineRef String?

  // Secure remediation guidance surfaced to the user (no secret material).
  remediationGuidance String?

  // Audit trail for quarantine access.
  quarantinedAt DateTime?
  reviewedBy    String?
  reviewedAt    DateTime?

  attachments SupportAttachment[]

  @@index([status, createdAt])
  @@index([userId])
}

model SupportAttachment {
  id           String   @id @default(uuid())
  createdAt      DateTime @default(now())

  submissionId String
  submission   SupportSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  // Original filename (not trusted for path resolution).
  filename     String
  // MIME type as declared by the client.
  contentType  String
  // Size in bytes.
  size         Int

  // Sha256 of the attachment content for deduplication and integrity.
  contentHash  String

  // Storage key for the quarantined blob (never inline in this row).
  quarantineKey String?

  // clean | quarantined | released
  status        String @default("clean")

  // Detection categories (JSON array of classifier labels, no secret values).
  detectionTypes String @default("[]")

  @@index([submissionId])
  @@index([contentHash])
  @@index([status])
}

model QuarantineAuditLog {
  id        String   @id @default(uuid())
  createdAt  DateTime @default(now())

  // Opaque actor reference (user id or system actor).
  actorId    String?
  // read | release | delete | create
  action      String
  // Opaque reference to the quarantined record (submission or attachment).
  targetType  String
  targetId    String
  // Non-sensitive context (JSON); never contains secret material.
  context     String @default("{}")

  @@index([targetType, targetId])
  @@index([actorId, createdAt])
}

// ----------------------------------------------------------------------------
// PREWAVE-BE-058: Inbound webhook signature verification & replay protection.
// Raw signed bytes are preserved so provider-specific HMAC/canonicalization
// can be recomputed exactly. Delivery-ID uniqueness is enforced at the DB
// level so replays are rejected transactionally. Secrets are never stored
// here — only opaque key identifiers for rotation bookkeeping.
// ----------------------------------------------------------------------------

model WebhookProviderConfig {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Provider identifier, e.g. "github", "stripe", "stellar". Unknown
  // providers must fail closed at the service layer.
  provider String @unique

  // Timestamp tolerance in seconds for replay-window enforcement.
  timestampToleranceSeconds Int @default(300)

  // Maximum accepted raw body size in bytes; oversized bodies are rejected
  // before signature verification.
  maxBodyBytes Int @default(1048576)

  // Whether this provider is currently active. Inactive providers fail closed.
  isActive Boolean @default(true)

  // Opaque reference to the current signing secret in the secret store.
  // Never the secret material itself.
  activeSecretRef String?

  // JSON array of opaque secret refs retained for rotation grace windows.
  rotatedSecretRefs String @default("[]")

  deliveries WebhookDelivery[]

  @@index([isActive])
}

model WebhookDelivery {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // Provider identifier (denormalized for fast lookup / audit).
  provider String

  // Provider-supplied delivery identifier; uniqueness per provider enforces
  // transactional replay rejection.
  deliveryId String

  // Opaque secret ref used to verify this delivery (supports rotation audit).
  secretRef String?

  // Provider-supplied timestamp (epoch seconds or ISO, provider-specific).
  // Stored as DateTime for tolerance checks; raw value preserved in headers.
  eventTimestamp DateTime?

  // SHA-256 of the raw signed body, for integrity and dedup diagnostics.
  bodySha256 String

  // Size of the raw body in bytes.
  bodyBytes Int

  // Verification outcome: "accepted" | "rejected". Rejected rows are kept
  // for audit; accepted rows are the transactional replay guard.
  status String @default("accepted")

  // Non-sensitive rejection reason (e.g. "bad_signature", "stale_timestamp",
  // "oversized_body", "unknown_provider"). Never contains secret material.
  rejectionReason String?

  // Server receipt time used for replay-window and tolerance auditing.
  receivedAt DateTime @default(now())

  @@unique([provider, deliveryId])
  @@index([provider, createdAt])
  @@index([status, createdAt])
  @@index([provider, receivedAt])
}
