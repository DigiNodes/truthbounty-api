// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
  binaryTargets = ["native", "linux-musl"]
}

// Actual runtime datasource is SQLite via the libsql driver adapter
// (see src/prisma/prisma.service.ts, DATABASE_URL=file:./dev.db) this 
// matches prisma/migrations/migration_lock.toml, which already records
// "sqlite" as the migration dialect. Declaring "postgresql" here caused
 // PrismaClientInitializationError at runtime ("Driver Adapter
// @prisma/adapter-libsql, based on sqlite, is not compatible with the
// provider postgress") once the client was regenerated against the
// package-lock-pinned prisma@7.4.1, which validates this consistency.
datasource db {
  provider = "sqlite"
}

enum UserRole {
  contributor
  moderator
  admin
}

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Primary wallet address — canonical identifier for the user
  walletAddress String @unique

  reputation Int @default(0)

  role UserRole @default(contributor)

  // Sybil Resistance
  worldcoinVerified   Boolean   @default(false)
  worldcoinVerifiedAt DateTime?

  wallets              Wallet[]
  sybilScores          SybilScore[]
  worldIdVerifications WorldIdVerification[]
  conversations        Conversation[]
}

model Wallet {
  id        String   @id @default(uuid())
  address   String
  chain     String
  linkedAt  DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([address, chain])
  // We will enforce "one address -> one user" logic in the service layer
  // to handle multi-chain address reguse scenarios properly.
}

model SybilScore {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Component scores (0-1 normalized)
  worldcoinScore Float @default(0.0) // Binary verification signal (0 or 1)
  walletAgeScore Float @default(0.0) // Based on wallet age
  stakingScore   Float @default(0.0) // Historical participation in staking
  accuracyScore  Float @default(0.0) // Claim accuracy from verification history

  // Final composite score (0-1)
  compositeScore Float @default(0.0) // Final Sybil resistance score

  // Metadata
  calculationDetails String? // JSON string for explainability

  explanation SybilExplanation?

  @@unique([userId, createdAt])
  @@index([userId])
  @@index([compositeScore])
}

model SybilExplanation {
  id           String   @id @default(uuid())
  sybilScoreId String   @unique
  explanation  String
  createdAt    DateTime @default(now())

  sybilScore SybilScore @relation(fields: [sybilScoreId], references: [id], onDelete: Cascade)
}

model WorldIdVerification {
  id          String   @id @default(uuid())
  verifiedAt  DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  nullifierHash     String  @unique
  verificationLevel String
  worldcoinAppId    String
  worldcoinAction   String
  merkleRoot        String?
  proof             Json?

  @@index([userId])
  @@index([nullifierHash])

  @@map("world_id_verifications")
}

model Conversation {
  id        String   @id @default(uuid())
  title     String?
  createdAt  DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  role           String       // "user", "assistant", "system"
  content        String
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())

  @@index([conversationId])
}

model ContextDocument {
  id        String   @id @default(uuid())
  title     String
  category  String
  content   String
  tags      String   // Stored as JSON string
  sourceUrl String?
  isActive  Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isActive])
}

model AiUsageMetric {
  id              String   @id @default(uuid())
  userId          String?
  provider        String   // e.g., "openai", "anthropic"
  model           String
  promptTokens    Int      @default(0)
  completionTokens Int     @default(0)
  totalTokens     Int      @default(0)
  latencyMs       Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([provider])
}

// Protocol Analytics & Reporting API models

model AnalyticsEvent {
  id        String   @id @default(uuid())
  eventType String // e.g., "claim_submitted", "verification_completed", "reward_distributed"
  entityType String? // e.g., "claim", "proposal", "user"
  entityId   String?
  userId    String?
  data        Json?
  occurredAt  DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([eventType, occurredAt])
  @@index([entityType, entityId])
  @@index([userId])
}

model MetricAggregate {
  id         String   @id @default(uuid())
  metricKey  String // e.g., "total_claims", "active_verifiers"
  period     String // e.g., "hourly", "daily", "weekly", "monthly", "yearly", "all"
  bucketStart DateTime
  filters    String @default("{}") // Canonical JSON string representing dimensions e.g. chain, role
  value       Float @default(0)
  updatedAt  DateTime @updatedAt

  @@index([metricKey, period, bucketStart])
  @@unique([metricKey, period, bucketStart, filters])
}

model ReportJob {
  id            String   @id @default(uuid())
  name          String?
  reportType    String // "protocol_summary", "user_analytics", "verification_analytics", "governance_analytics", "financial_analytics", "custom"
  filters      Json?
  format       String @default("json") // "json", "csv", "pdf"
  status       String @default("pending") // "pending", "running", "completed", "failed"
  progress      Float @default(0)
  fileUrl       String?
  error         String?
  createdAt     DateTime @default(now())
  startedAt     DateTime?
  completedAt    DateTime?
  scheduledFor   DateTime?
  createdByUserId String?

  @@index([status])
  @@index([createdAt])
  @@index([scheduledFor])
}

model MonitoringMetric {
  id         String   @id @default(uuid())
  name        String // e.g., "report_generation_time", "query_latency", "cache_hit_ratio"
  value       Float
  labels       Json?
  recordedAt   DateTime @default(now())

  @@index([name, recordedAt])
}

// V2 indexing: chain event dedup + reorg-aware block cursor.
//
// This is an indexing/read boundary only. The API indexes, validates,
// caches, and relays user-signed intent — it is never authoritative for
// protocol settlement, rewards, treasury, or governance, all of which
// live on-chain. Optimism/EVM semantics only (chainId + 32-byte hashes);
// no Stellar/Soroban/Freighter concepts belong here.

model ChainEvent {
  id              String    @id @default(uuid())
  chainId         Int
  contractAddress String
  eventName       String

  // BigInt, never a JS number/float — block numbers can exceed
  // Number.MAX_SAFE_INTEGER and must sort/compare numerically, not lexically.
  blockNumber     BigInt
  blockHash       String
  txHash          String
  logIndex        Int
  blockTimestamp  DateTime?

  payload   Json
  rawArgs   Json
  ingestedAt DateTime @default(now())

  // Canonical log identity is (chain, block hash, tx hash, log index) —
  // deliberately including blockHash alongside chainId/txHash/logIndex.
  // After a reorg, the same txHash+logIndex can legitimately reappear
  // under a *different* blockHash once it's re-included in the
  // replacement chain. Keying only on (chainId, txHash, logIndex) would
  // make that valid replacement-chain log collide with — and get
  // silently dropped as a duplicate of — the orphaned original. Keying on
  // the full 4-tuple lets true duplicates (identical replay of the same
  // log) be rejected while still accepting the replacement-chain log as
  // a distinct row.
  @@unique([chainId, blockHash, txHash, logIndex], name: "chainId_blockHash_txHash_logIndex")
  @@index([chainId, blockNumber])
  @@index([eventName, blockNumber])
  @@index([contractAddress])
  @@map("v2_chain_events")
}

enum BlockConfirmation {
  observed
  safe
  finalized
}

model BlockCursor {
  id     String @id @default(uuid())
  chainId Int
  // Logical ingestion source (e.g. a contract address, or an indexer
  // name for a multi-contract stream) — a chain can have more than one
  // independently-advancing cursor.
  source  String

  // Highest block this cursor has processed, and that block's own hash
  // (not its parent's) — the pair needed to detect, on the next poll,
  // whether the chain reorged underneath us. BigInt for correct numeric
  // ordering/comparison (a decimal string would sort lexically).
  processedHeight BigInt
  processedHash   String

  // Finality-lagged cursors used to gate what's safe to read/finalize.
  safeHeight      BigInt @default(0)
  safeHash        String @default("")
  finalizedHeight BigInt @default(0)
  finalizedHash   String @default("")

  updatedAt DateTime @updatedAt

  ancestry BlockCursorAncestor[]

  @@unique([chainId, source])
  @@map("v2_block_cursors")
}

// Rolling window of recently-processed block headers (height, hash,
// parentHash) per cursor. On a reorg, recovery walks this ancestry
// newest-to-oldest comparing stored hashes against the RPC's current
// canonical chain until it finds a matching (height, hash) pair — the
// common ancestor — then rolls the cursor back to it before re-ingesting
// forward. Without stored ancestry there is no way to find that ancestor
// short of re-scanning from genesis.
model BlockCursorAncestor {
  id       String      @id @default(uuid())
  cursorId String
  cursor   BlockCursor @relation(fields: [cursorId], references: [id], onDelete: Cascade)

  height     BigInt
  hash       String
  parentHash String

  // Flipped to false, rather than deleted, when a reorg orphans this
  // block — keeps the audit trail of what was seen and later replaced.
  isCanonical  Boolean            @default(true)
  confirmation BlockConfirmation  @default(observed)
  recordedAt   DateTime           @default(now())

  @@unique([cursorId, height, hash])
  @@index([cursorId, height])
  @@map("v2_block_cursor_ancestors")
}
