# ==============================================
# Application Configuration
# ==============================================
# NOTE: This file is the single source of truth for environment keys.
# Do not add duplicate or contradictory keys. See docs/env-schema.md.
NODE_ENV=development
PORT=3000

# ==============================================
# Database Configuration (PostgreSQL)
# ==============================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=truthbounty
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/truthbounty

# TypeORM settings
DATABASE_SYNCHRONIZE=false  # Set to 'true' only in development (auto-sync schema)
DATABASE_LOGGING=false      # Set to 'true' to enable SQL query logging

# ==============================================
# Redis Configuration
# ==============================================
# The application will start even if Redis is unavailable (with warnings)
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false  # Set to 'true' for production with TLS
CACHE_CLAIMS_TTL=300  # Claim cache TTL in seconds (reduced to 5 minutes for safety)
CACHE_VERSION=v1       # Cache version for versioned keys - increment when cache schema changes

# ==============================================
# Blockchain Configuration
# ==============================================
# Controls how many blocks, events, and reorg entries are kept in memory
BLOCKCHAIN_MAX_BLOCKS=10000        # Max block records in memory (default: 10000)
BLOCKCHAIN_MAX_EVENTS=50000        # Max pending/confirmed/orphaned events (default: 50000)
BLOCKCHAIN_MAX_REORG_HISTORY=1000  # Max reorg history entries (default: 1000)

# Rate limiting (requests per TTL in seconds)
RATE_LIMIT_CLAIMS_TTL=60
RATE_LIMIT_CLAIMS_LIMIT=5
RATE_LIMIT_VOTES_TTL=60
RATE_LIMIT_VOTES_LIMIT=20
RATE_LIMIT_DISPUTES_TTL=60
RATE_LIMIT_DISPUTES_LIMIT=3
RATE_LIMIT_AI_TTL=60
RATE_LIMIT_AI_LIMIT=10
RATE_LIMIT_AI_STREAM_TTL=60
RATE_LIMIT_AI_STREAM_LIMIT=3
OPTIMISM_RPC_URL=https://mainnet.optimism.io
CHAIN_ID=10

# Event Indexer Configuration
CONFIRMATIONS_REQUIRED=12
BLOCK_RANGE_PER_BATCH=5000
MAX_RETRY_ATTEMPTS=3
POLLING_INTERVAL_MS=12000

# V2-BE-125 — Adaptive Historical Backfill
# Minimum block-range floor used by the adaptive halving logic.
# When a provider rejects a getLogs range as too large, the service halves
# the range repeatedly until it succeeds or reaches this floor.
MIN_BATCH_SIZE_FLOOR=1

# Gap (in blocks) above which backfillFromBlock enters high-throughput
# adaptive mode (no polling-interval delay between batches).
# Set lower for staging environments with smaller chains.
ADAPTIVE_FILL_THRESHOLD_BLOCKS=10000

# Realtime Event Stream Configuration
# Projection-backed SSE stream (outbox publish-after-commit, resume cursor, heartbeat, backpressure)
REALTIME_POLL_INTERVAL_MS=1000          # Outbox publisher poll interval (ms)
REALTIME_MAX_PUBLISH_BATCH=100          # Max outbox rows published per pass
REALTIME_HEARTBEAT_INTERVAL_MS=15000    # Heartbeat interval for idle streams (ms)
REALTIME_MAX_BACKLOG=1000               # Max queued envelopes per subscriber before disconnect
REALTIME_MAX_REPLAY_ROWS=5000           # Max historical rows replayed on resume cursor

# ==============================================
# Sybil Resistance Configuration
# ==============================================
# accuracy score contributes to their sybil resistance score.
SYBIL_MIN_CLAIMS_FOR_ACCURACY_SCORE=5

# ==============================================
# Authentication Configuration (JWT)
# ==============================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
# JWT token expiration time (e.g., '7d', '24h', '60m')
JWT_EXPIRATION=7d

# ==============================================
# SIWE (Sign-In with Ethereum) — EIP-4361 (V2-BE-063)
# ==============================================
# Expected SIWE message fields. These are validated fail-closed during login:
# a message that does not match the deployed trust context is rejected.
SIWE_DOMAIN=app.truthbounty.com
# Comma-separated origins that may present a SIWE signature.
SIWE_ALLOWED_ORIGINS=https://app.truthbounty.com
# Comma-separated domains allowed to issue the authorization message.
SIWE_ALLOWED_DOMAINS=app.truthbounty.com,truthbounty.com
# Comma-separated chain IDs accepted for the signing wallet (Optimism = 10).
SIWE_SUPPORTED_CHAIN_IDS=10
# Exact SIWE statement that must appear in the signed message.
SIWE_EXPECTED_STATEMENT=Sign in to TruthBounty V2 to verify wallet ownership.
# SIWE nonce lifetime in milliseconds before it is considered stale.
AUTH_NONCE_TTL_MS=300000

# ==============================================
# Staging Deployment Smoke Tests (V2-BE-146)
# ==============================================
# Base URL of the deployed instance to smoke-test; used by
# `npm run smoke:staging` and the workflow via the staging_base_url secret.
STAGING_BASE_URL=
# Per-probe timeout in milliseconds for the smoke test suite.
SMOKE_TIMEOUT_MS=10000

# ==============================================
# Idempotency Configuration
# ==============================================
IDEMPOTENCY_ENABLED=true
# Time-to-live for stored responses in seconds (default: 24 hours)
IDEMPOTENCY_TTL=86400
# Required length of idempotency keys in characters (default: 32)
IDEMPOTENCY_KEY_LENGTH=32

# ==============================================
# Notification Service Configuration
# ==============================================
# SMTP configuration for email delivery
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@truthbounty.com

# Notification queue configuration
NOTIFICATION_QUEUE_DELAY=0
NOTIFICATION_MAX_RETRIES=5
NOTIFICATION_RETRY_DELAY=2000

# ==============================================
# Metrics Configuration
# ==============================================
# Explicit disable mode for Prometheus metrics. Default: enabled.
# Only the exact value 'false' disables metrics: GET /metrics then returns
# 404 and notification metric recording becomes a no-op. METRICS_TOKEN
# (see METRICS_SECURITY.md) additionally authenticates scrapers but does
# not disable the endpoint.
METRICS_ENABLED=true

# ==============================================
# Canonical Contract Release Manifest (STAB-BE-007)
# ==============================================
# release package. The manifest is the single source of truth for chain ID,
# release ID, deployment block, contract addresses and ABI/event checksums.
# Hand-maintained addresses and INDEXED_CONTRACTS are no longer accepted.
CONTRACT_RELEASE_MANIFEST_PATH=./contracts/releases/latest.json

# Canonical RPC endpoint used by the indexer and API. Credentials are redacted in logs.
BLOCKCHAIN_RPC_URL=https://mainnet.optimism.io

# Expected release ID; startup fails if the manifest release ID does not match.
CONTRACT_RELEASE_ID=

# Expected chain ID; startup fails if the manifest chain ID does not match.
CONTRACT_RELEASE_CHAIN_ID=10

# Expected deployment block; startup fails if the manifest block does not match.
CONTRACT_RELEASE_DEPLOYMENT_BLOCK=

# Maximum age of the manifest in days before it is considered stale (default 90)
CONTRACT_RELEASE_MAX_AGE_DAYS=90

# Fail closed when release data is absent or inconsistent.
# MUST be true in staging/production. Only set false for explicit local mode.
CONTRACT_RELEASE_STRICT=true

# ==============================================
# Local Development Mode (STAB-BE-007)
# ==============================================
# Explicit opt-in for local development. When true, the app runs in a
# visibly non-production mode, allows empty indexer configuration, and
# relaxes release manifest requirements. MUST be false in staging/production.
LOCAL_DEV_MODE=false

# ==============================================
# Circuit Breaker Configuration (Task 3)
# ==============================================
# Failure thresholds (consecutive failures before circuit opens)
CB_FAILURE_THRESHOLD_DATABASE=5
CB_FAILURE_THRESHOLD_REDIS=5
CB_FAILURE_THRESHOLD_RPC=5
CB_FAILURE_THRESHOLD_IPFS=5
CB_FAILURE_THRESHOLD_QUEUE=5

# Reset windows (ms before an OPEN circuit transitions to HALF_OPEN)
CB_RESET_MS_DATABASE=30000
CB_RESET_MS_REDIS=30000
CB_RESET_MS_RPC=30000
CB_RESET_MS_IPFS=30000
CB_RESET_MS_QUEUE=30000

# Per-dependency call timeouts (ms); set to 0 to disable
DEPENDENCY_TIMEOUT_DATABASE=5000
DEPENDENCY_TIMEOUT_REDIS=2000
DEPENDENCY_TIMEOUT_RPC=10000
DEPENDENCY_TIMEOUT_IPFS=15000
DEPENDENCY_TIMEOUT_QUEUE=5000

# ==============================================
# Logging Redaction (STAB-BE-007)
# ==============================================
# redacted from logs and error output. RPC credentials and secrets must
# never appear in logs.
LOG_REDACT_KEYS=DB_PASSWORD,DATABASE_URL,REDIS_PASSWORD,JWT_SECRET,SMTP_PASS,BLOCKCHAIN_RPC_URL,OPTIMISM_RPC_URL,CONTRACT_RELEASE_MANIFEST_PATH
LOG_REDACT_RPC_URLS=true
# ==============================================
# Abuse Signals (PREWAVE-BE-086 / #681)
# ==============================================
# Detect scraping, credential stuffing, spam submissions, webhook abuse,
# stream storms and support flooding. Signals are advisory to the API's own
# delivery surface only and can never change a canonical, on-chain outcome.
# See docs/ABUSE_SIGNALS.md before changing anything here.
#
# Two separate gates. ABUSE_SIGNALS_ENABLED controls whether observations are
# recorded at all. ABUSE_SIGNALS_ENFORCEMENT_ENABLED controls whether an action
# may refuse a request, and it is OFF by default: turning it on is a deliberate
# maintainer decision, so this candidate can be merged and observed first.
ABUSE_SIGNALS_ENABLED=true
ABUSE_SIGNALS_ENFORCEMENT_ENABLED=false

# HMAC salt used to derive subject keys. Subjects are stored and logged as
# salted digests only, never as addresses, wallets or user ids. Must be at
# least 32 characters. Rotating it invalidates existing subject keys, so
# in-flight actions stop matching their subject and expire naturally.
# Without this, no request is attributable and no action is ever issued.
ABUSE_SIGNALS_SUBJECT_SALT=replace-with-at-least-32-random-characters

# Proxy hops the deployment actually trusts when reading X-Forwarded-For.
# 0 means the socket address only. Entries beyond this count are discarded,
# so a caller cannot widen its own trusted prefix by prepending to the header.
# Keep in step with TRUSTED_PROXIES and MAX_PROXY_HOPS.
ABUSE_SIGNALS_TRUSTED_PROXY_HOPS=0

# Evaluation window (seconds) and the bounds on any action it can produce.
# The action ceiling is additionally clamped to 24h regardless of this value.
ABUSE_SIGNALS_WINDOW_SECONDS=300
ABUSE_SIGNALS_MAX_ACTION_SECONDS=900
ABUSE_SIGNALS_MAX_ACTIONS_PER_SUBJECT=3

# Per-detector thresholds, counted inside one window. Raising a threshold
# loosens detection; a malformed value aborts startup rather than silently
# disabling a guard. Note that several detectors additionally require two
# independent signals to agree before any action is issued, so a single
# threshold is never sufficient on its own.
ABUSE_SIGNALS_SCRAPE_MAX_READS=600
ABUSE_SIGNALS_SCRAPE_MAX_ROUTES=40
ABUSE_SIGNALS_STUFFING_MAX_FAILURES=20
ABUSE_SIGNALS_STUFFING_MAX_DISTINCT_CREDENTIALS=5
ABUSE_SIGNALS_STUFFING_MAX_DISTINCT_SUBJECTS=10
ABUSE_SIGNALS_SPAM_MAX_WRITES=30
ABUSE_SIGNALS_SPAM_MAX_DUPLICATE_PAYLOADS=10
ABUSE_SIGNALS_WEBHOOK_MAX_ENDPOINT_WRITES=15
ABUSE_SIGNALS_WEBHOOK_MAX_SECRET_ROTATIONS=5
ABUSE_SIGNALS_WEBHOOK_MAX_DELIVERIES=200
ABUSE_SIGNALS_STREAM_MAX_CONNECTIONS=25
ABUSE_SIGNALS_STREAM_MAX_SUBSCRIBE_OPS=60
ABUSE_SIGNALS_STREAM_MAX_MESSAGES=300
ABUSE_SIGNALS_SUPPORT_MAX_REQUESTS=30
ABUSE_SIGNALS_SUPPORT_MAX_DUPLICATE_REQUESTS=20
ABUSE_SIGNALS_SUPPORT_MAX_DISTINCT_CONTACTS=25
