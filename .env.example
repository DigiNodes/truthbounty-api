# FCM_SERVICE_ACCOUNT_PATH=

# Firebase service account JSON (inline, for containerized deployments)
# FCM_SERVICE_ACCOUNT_JSON=

# true or false
WEBHOOK_REQUIRE_HTTPS=true

# integer 1..9007199254740991
WEBHOOK_TIMEOUT_MS=10000

# JSON object mapping webhook secret key IDs to base64url-encoded 32-byte AES-GCM keys
# WEBHOOK_SECRET_KEYS=

# key ID used to encrypt newly configured webhook secrets
# WEBHOOK_SECRET_ACTIVE_KEY_ID=

# base64url-encoded 32-byte AES-GCM key for single-key deployments
# WEBHOOK_SECRET_KEY=

# non-empty string; required explicitly in staging/production
# AUDIT_HASH_SECRET=

# non-empty string
AUDIT_ARCHIVAL_BUCKET=audit-archive

# true or false
AUDIT_ARCHIVAL_ENABLED=false

# true or false
AUDIT_ASYNC_WRITES_ENABLED=true

# integer 1..9007199254740991
AUDIT_BATCH_SIZE=50

# non-empty string
# AUDIT_LOG_RETENTION_CRON=

# integer 1..9007199254740991
AUDIT_LOG_RETENTION_DAYS=365

# integer 1..9007199254740991
AUDIT_PII_RETENTION_DAYS=30

# integer 1..3650
EVENT_QUARANTINE_RETENTION_DAYS=90

# integer 1..9007199254740991
AUDIT_MAX_BATCH_WAIT_MS=1000

# non-empty string
AUDIT_METRIC_PREFIX=audit

# integer 1..9007199254740991
AUDIT_MAX_API_CALLS=100

# integer 1..9007199254740991
AUDIT_MAX_FAILED_LOGINS=5

# integer 1..9007199254740991
AUDIT_MAX_PERMISSION_CHANGES=3

# integer 1..9007199254740991
AUDIT_SUSPICIOUS_WINDOW_MINUTES=15

# non-empty string
BACKUP_STORAGE_DIR=/var/backups/truthbounty-v2

# non-empty string
# REBUILD_SCHEMA=

# 24-hour HH:mm time
MAINTENANCE_WINDOW_START=02:00

# 24-hour HH:mm time
MAINTENANCE_WINDOW_END=04:00

# non-empty string
# WORLDCOIN_ACTION=

# non-empty string
# WORLDCOIN_APP_ID=

# URL (https:, http:)
# WORLDCOIN_VERIFY_BASE_URL=

# integer 1..9007199254740991
CB_FAILURE_THRESHOLD_DATABASE=5

# integer 1..9007199254740991
CB_FAILURE_THRESHOLD_REDIS=5

# integer 1..9007199254740991
CB_FAILURE_THRESHOLD_RPC=5

# integer 1..9007199254740991
CB_FAILURE_THRESHOLD_IPFS=5

# integer 1..9007199254740991
CB_FAILURE_THRESHOLD_QUEUE=5

# integer 1..9007199254740991
CB_RESET_MS_DATABASE=30000

# integer 1..9007199254740991
CB_RESET_MS_REDIS=30000

# integer 1..9007199254740991
CB_RESET_MS_RPC=30000

# integer 1..9007199254740991
CB_RESET_MS_IPFS=30000

# integer 1..9007199254740991
CB_RESET_MS_QUEUE=30000

# integer 0..9007199254740991
DEPENDENCY_TIMEOUT_DATABASE=5000

# integer 0..9007199254740991
DEPENDENCY_TIMEOUT_REDIS=2000

# integer 0..9007199254740991
DEPENDENCY_TIMEOUT_RPC=10000

# integer 0..9007199254740991
DEPENDENCY_TIMEOUT_IPFS=15000

# integer 0..9007199254740991
DEPENDENCY_TIMEOUT_QUEUE=5000
